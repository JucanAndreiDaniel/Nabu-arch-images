#!/usr/bin/ash
# davinci_nested: expose the nested GPT inside the hosting partition
# (linux, falling back to userdata) as partitioned loop devices.
#
# Layout (must match CI nested-image assembly, 4096-byte sectors):
#   p1 ESP  (1MiB..513MiB,  partition name ESP)
#   p2 root (from 513MiB,   partition name ARCH)
#
# losetup -P --sector-size 4096 yields ${loop}p1/${loop}p2 with real
# partition uevents, so udev creates native by-partlabel symlinks WITHOUT
# blkid probing. (Plain offset loops expose no partitions; the real root's
# udev never materialized their device units and systemd stalled on the
# root device.) Root is mounted with root=PARTLABEL=ARCH.

run_hook() {
    local host="" loop

    # Debug UKI passes davinci_debug on the cmdline: trace every step so a
    # stalled boot still leaves evidence on serial/fbcon/pstore.
    if grep -q 'davinci_debug' /proc/cmdline 2>/dev/null; then
        echo "davinci_nested: DEBUG on, cmdline: $(cat /proc/cmdline)"
        set -x
    fi

    for part in linux userdata; do
        if poll_device "/dev/disk/by-partlabel/${part}" 10; then
            host="/dev/disk/by-partlabel/${part}"
            break
        fi
    done
    if [ -z "$host" ]; then
        echo "davinci_nested: no linux/userdata hosting partition found"
        echo "davinci_nested: by-partlabel contents:"
        ls -l /dev/disk/by-partlabel/ || true
        if command -v blkid >/dev/null 2>&1; then blkid || true; fi
        return 1
    fi
    msg "davinci_nested: hosting partition $host"

    loop=$(losetup --sector-size 4096 -P --show -f "$host") || {
        echo "davinci_nested: partitioned loop setup failed"
        return 1
    }
    msg "davinci_nested: nested GPT on $loop"
    if ! poll_device "${loop}p2" 10; then
        echo "davinci_nested: ${loop}p2 never appeared"
        losetup -d "$loop" || true
        return 1
    fi
    msg "davinci_nested: ESP on ${loop}p1, root on ${loop}p2"
    if command -v blkid >/dev/null 2>&1; then blkid "${loop}p1" "${loop}p2" || true; fi
    if command -v udevadm >/dev/null 2>&1; then udevadm settle || true; fi
    if grep -q 'davinci_debug' /proc/cmdline 2>/dev/null; then
        set +x
        echo "davinci_nested: DEBUG done, continuing to mount root"
    fi
}
