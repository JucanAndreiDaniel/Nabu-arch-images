#!/usr/bin/ash
# davinci_gadget: bind an ACM+ECM composite gadget (serial console/logs +
# USB networking for SSH) on the first UDC.
#
# Runs both in the initramfs (this hook, early USB logs) and as a backstop
# real-root service (udev-triggered on UDC add + after multi-user): both
# are idempotent (skip when already bound) and never fail the boot.
# Modules (libcomposite u_serial usb_f_acm u_ether usb_f_ecm) come from
# mkinitcpio MODULES / the rootfs; modprobe here is best-effort ordering
# for minimal (busybox) modprobe implementations.

run_hook() {
    local udc="" g="/sys/kernel/config/usb_gadget/davinci" i=0

    [ -d /sys/kernel/config ] || return 0
    mount -t configfs none /sys/kernel/config 2>/dev/null || true
    if command -v modprobe >/dev/null 2>&1; then
        for m in libcomposite u_serial u_ether usb_f_acm usb_f_ecm configfs usb_configfs; do
            modprobe "$m" 2>/dev/null || true
        done
    fi
    while [ "$i" -lt 5 ]; do
        udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        [ -n "$udc" ] && break
        sleep 1
        i=$((i + 1))
    done
    if [ -z "$udc" ]; then
        echo "davinci_gadget: no UDC yet, real-root service will retry"
        return 0
    fi
    if [ -e "$g/UDC" ] && [ -n "$(cat "$g/UDC" 2>/dev/null)" ]; then
        msg "davinci_gadget: already bound ($(cat "$g/UDC"))"
        return 0
    fi
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" \
        "$g/functions/ecm.usb0" "$g/functions/acm.gs0" 2>/dev/null || return 0
    echo 0x1d6b > "$g/idVendor" 2>/dev/null || return 0
    echo 0x0104 > "$g/idProduct" 2>/dev/null || return 0
    echo "davinci" > "$g/strings/0x409/manufacturer" 2>/dev/null || true
    echo "arch-linux" > "$g/strings/0x409/product" 2>/dev/null || true
    echo 500 > "$g/configs/c.1/MaxPower" 2>/dev/null || true
    echo "net+serial" > "$g/configs/c.1/strings/0x409/configuration" 2>/dev/null || true
    echo "02:00:86:10:20:01" > "$g/functions/ecm.usb0/dev_addr" 2>/dev/null || true
    echo "02:00:86:10:20:02" > "$g/functions/ecm.usb0/host_addr" 2>/dev/null || true
    ln -s "$g/functions/ecm.usb0" "$g/configs/c.1/" 2>/dev/null || true
    ln -s "$g/functions/acm.gs0" "$g/configs/c.1/" 2>/dev/null || true
    if echo "$udc" > "$g/UDC" 2>/dev/null; then
        msg "davinci_gadget: bound ECM+ACM on $udc"
    else
        echo "davinci_gadget: bind failed (UDC busy?), continuing"
    fi
    return 0
}
