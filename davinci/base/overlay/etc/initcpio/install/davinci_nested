#!/bin/bash
# mkinitcpio install hook for davinci_nested: pull in a real losetup
# (busybox's is not enough) and the run script.

build() {
    add_binary losetup
    add_runscript
}

help() {
    cat <<HELPEOF
Expose the nested davinci partitions (FAT ESP + ext4 root living
inside the userdata/linux hosting partition) as partitioned loop devices
so root=PARTLABEL=ARCH can mount.
HELPEOF
}
