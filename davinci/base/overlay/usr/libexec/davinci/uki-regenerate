#!/usr/bin/env bash
set -euo pipefail

# Regenerate the davinci UKI (systemd-boot Type 2) after linux-davinci
# installs/upgrades. Usable directly for custom/local kernel builds.

kernver="${1:-$(ls /usr/lib/modules/ 2>/dev/null | sort -V | tail -1)}"
if [ -z "$kernver" ]; then
    echo "No kernel version found" >&2
    exit 1
fi

echo "Regenerating UKI for kernel ${kernver}..."

if [ ! -f /etc/cmdline.d/root.conf ]; then
    mkdir -p /etc/cmdline.d
    printf 'root=PARTLABEL=ARCH rw rootwait\n' > /etc/cmdline.d/root.conf
fi

cat > /etc/mkinitcpio.d/linux-davinci.preset << PRESET
# mkinitcpio preset file for the 'linux-davinci' package

ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-${kernver}"

PRESETS=('default' 'debug' 'debug_nokaslr' 'debug_novamap')

default_uki="/boot/EFI/Linux/arch-linux-davinci.efi"
default_cmdline="/etc/cmdline.d/combined-default.conf"
debug_uki="/boot/EFI/Linux/arch-linux-davinci-debug.efi"
debug_cmdline="/etc/cmdline.d/combined-debug.conf"
debug_nokaslr_uki="/boot/EFI/Linux/arch-linux-davinci-debug-nokaslr.efi"
debug_nokaslr_cmdline="/etc/cmdline.d/combined-debug-nokaslr.conf"
debug_novamap_uki="/boot/EFI/Linux/arch-linux-davinci-debug-novamap.efi"
debug_novamap_cmdline="/etc/cmdline.d/combined-debug-novamap.conf"
PRESET

if [ -f /usr/lib/kernel/uki.conf ]; then
    sed -i "s|^DeviceTree=.*|DeviceTree=/boot/dtb-${kernver}|" /usr/lib/kernel/uki.conf
fi

# mkinitcpio bakes one cmdline file per preset (see combine-cmdline).
/usr/libexec/davinci/combine-cmdline

# /boot lives on the rootfs for davinci v1 (no separate ESP partition).
mkdir -p /boot/EFI/Linux
# Preserve the previous default UKI (upstream nabu pattern) so a bad
# on-device kernel upgrade stays recoverable from the boot menu via the
# arch-davinci-old entry. No-op on fresh installs.
if [ -f /boot/EFI/Linux/arch-linux-davinci.efi ]; then
    cp -f /boot/EFI/Linux/arch-linux-davinci.efi /boot/EFI/Linux/arch-linux-davinci-old.efi
    echo "Preserved previous UKI as arch-linux-davinci-old.efi"
fi
mkinitcpio -P

echo "UKI regeneration complete for kernel ${kernver}"
ls -l /boot/EFI/Linux/
