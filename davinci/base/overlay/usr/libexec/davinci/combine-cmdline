#!/usr/bin/env bash
# Combine /etc/cmdline.d fragments into the single files baked into the UKIs.
#
# mkinitcpio presets take ONE default_cmdline file per preset, not a
# directory: without this step only root.conf would reach the kernel and
# console=... / debug flags would be silently dropped.
#
# Layout (no USB serial anywhere: console=tty0 only):
#   combined-default.conf       = root.conf + davinci.conf (verbose bring-up,
#                                 no quiet until the UI shows)
#   combined-debug.conf         = root.conf + davinci.conf + debug.conf
#                                 (ignore_loglevel, drm.debug, davinci_debug hook)
#
# Retired: debug-nokaslr / debug-novamap combos (KASLR placement and EFI
# runtime-mapping hypotheses, ruled out once the phone booted to login)
# and anything USB-serial (composite hook, gserial UKI, console=ttyGS0 —
# serial is fully retired, see SERIAL-BRIEF §18).
# Their fragments/presets/UKIs are removed; overlay-post-apply deletes
# the leftovers from existing images.
#
# Re-run after ANY fragment edit: overlay-post-apply, uki-regenerate and
# the CI image build all call this helper. No UUID filling is needed
# anywhere: root/fstab use PARTLABEL (see root.conf, fstab).
set -euo pipefail

cd /etc/cmdline.d

for f in root.conf davinci.conf debug.conf; do
  [ -f "$f" ] || { echo "combine-cmdline: missing $f" >&2; exit 1; }
done

# NOTE: `paste -sd' '` joins lines only WITHIN each file, not across files
# (it pastes each file serially), so it leaves embedded newlines between
# fragments — kernel cmdline must be ONE line. Join explicitly instead.
join1() { cat "$@" | tr '\n' ' ' | sed 's/ *$/\n/'; }
join1 root.conf davinci.conf > combined-default.conf
join1 root.conf davinci.conf debug.conf > combined-debug.conf

echo "combine-cmdline: default:       $(cat combined-default.conf)"
echo "combine-cmdline: debug:         $(cat combined-debug.conf)"
