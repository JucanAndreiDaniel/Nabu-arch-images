#!/bin/sh
# davinci-forensics: headless flight recorder.
#
# The USB serial is output-only from some hosts, so scream the diagnostics
# at every console on each boot instead of waiting for a login that may
# never come. Safe to run always: best-effort throughout, can never fail
# the boot. First boot after flashing has no predecessor (empty section);
# the second boot prints the first boot's death.
{
echo "===== davinci-forensics: previous boot tail (-b -1) ====="
journalctl -b -1 -e --no-pager --no-hostname 2>&1 | tail -50
echo "===== previous boot: logind ====="
journalctl -b -1 -u systemd-logind --no-pager --no-hostname 2>&1 | tail -20
echo "===== net-gadget status (this boot + previous) ====="
systemctl status davinci-net-gadget.service --no-pager --no-hostname 2>&1 | tail -12
journalctl -b -1 -u davinci-net-gadget --no-pager --no-hostname 2>&1 | tail -10
echo "===== previous boot: power/reboot/fail lines ====="
journalctl -b -1 --no-pager --no-hostname 2>&1 | grep -iE "power key|powering|reboot|shut|thermal|watchdog|failed|failure" | tail -25
echo "===== wtmp runlevel history ====="
last -x -n 8 2>&1
echo "===== this boot: failed units ====="
systemctl --failed --no-pager --no-legend 2>&1
echo "===== input devices ====="
cat /proc/bus/input/devices 2>&1
echo "===== power supplies ====="
cat /sys/class/power_supply/*/capacity /sys/class/power_supply/*/status 2>&1
echo "===== thermal zones ====="
cat /sys/class/thermal/thermal_zone*/temp 2>&1 || echo "(no thermal zones)"
echo "===== kernel identity ====="
uname -a 2>&1
echo "===== filesystems: configfs registered? ====="
grep -iE "configfs" /proc/filesystems 2>&1 || echo "(configfs NOT in /proc/filesystems)"
echo "===== usb gadget state ====="
ls /sys/class/udc 2>&1
ls /dev/ttyGS* 2>&1
ls /lib/modules/"$(uname -r)"/kernel/drivers/usb/gadget/ 2>&1
ls /lib/modules/"$(uname -r)"/kernel/drivers/usb/gadget/function/ 2>&1
ls /lib/modules/"$(uname -r)"/kernel/drivers/usb/gadget/legacy/ 2>&1
echo "===== mount+gadget units (this boot) ====="
systemctl status sys-kernel-config.mount --no-pager --no-hostname 2>&1 | tail -12
journalctl -b -0 -u sys-kernel-config.mount --no-pager --no-hostname 2>&1 | tail -8
systemctl status davinci-net-gadget.service --no-pager --no-hostname 2>&1 | tail -8
echo "===== dmesg usb/configfs ====="
dmesg 2>&1 | grep -iE "configfs|gadget|udc |dwc3|g_serial|composite|ecm|acm|ttyGS" | tail -25
echo "===== forensics done ====="
# Tee everything to a persistent log too: read it (or the full journal)
# later via UMS, no serial-scraping needed:
#   mount rootfs, cat /mnt/davinci-root/var/log/davinci-forensics.log
#   journalctl --directory=/mnt/davinci-root/var/log/journal -b -1 -e
} 2>&1 | tee /var/log/davinci-forensics.log /dev/ttyGS0 /dev/tty0 > /dev/null 2>&1 || true
sync 2>/dev/null || true
