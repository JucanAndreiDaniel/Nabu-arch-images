#!/usr/bin/env bash
# Davinci overlay post-apply (runs inside arch-chroot).
# Sets up the linux-davinci mkinitcpio preset + DTB pointer and holds the
# fork kernel so generic linux-aarch64 cannot replace it.

kernver=$(ls /usr/lib/modules/ | sort -V | tail -1)
if [ -n "$kernver" ]; then
  cat > /etc/mkinitcpio.d/linux-davinci.preset << PRESET
# mkinitcpio preset file for the 'linux-davinci' package

ALL_kver="$kernver"

PRESETS=('default')

default_uki="/boot/EFI/Linux/arch-linux-davinci.efi"
default_cmdline="/etc/cmdline.d/root.conf"
PRESET

  sed -i "s|^DeviceTree=.*|DeviceTree=/boot/dtb-${kernver}|" /usr/lib/kernel/uki.conf
else
  echo "ERROR: no kernel modules found in /usr/lib/modules - is linux-davinci installed?" >&2
  exit 1
fi

# Root lives on a nested partition inside userdata/linux, exposed by the
# davinci_nested hook (offset loop). It must run before filesystems mounts
# root. The pattern below no longer matches once inserted (idempotent).
sed -i 's/^HOOKS=(\(.*\) block filesystems fsck)/HOOKS=(\1 block davinci_nested filesystems fsck)/' /etc/mkinitcpio.conf
grep -q 'davinci_nested' /etc/mkinitcpio.conf || {
  echo "ERROR: failed to insert davinci_nested into mkinitcpio HOOKS" >&2
  exit 1
}

# Pin modules autodetect would miss (it probes the CI build host, not the
# phone). Resolve names against the installed modules: the Goodix driver
# builds as goodix_ts.ko, not goodix.ko. Touch is not needed to mount root,
# so warn instead of failing when no candidate exists.
touch_mods=()
for m in goodix_ts goodix; do
  if [ -n "$kernver" ] && find "/usr/lib/modules/${kernver}" -name "${m}.ko*" -print -quit 2>/dev/null | grep -q .; then
    touch_mods+=("$m")
  fi
done
if [ "${#touch_mods[@]}" -gt 0 ]; then
  # Idempotent: the empty-tuple pattern only matches once.
  sed -i "s/^MODULES=()$/MODULES=(${touch_mods[*]})/" /etc/mkinitcpio.conf
  grep -q "^MODULES=(${touch_mods[*]})$" /etc/mkinitcpio.conf || {
    echo "ERROR: failed to set mkinitcpio MODULES" >&2
    exit 1
  }
else
  echo "WARNING: no touchscreen module found in /usr/lib/modules/${kernver}; leaving MODULES empty" >&2
fi

sed -i '/^IgnorePkg/d' /etc/pacman.conf
if grep -q '^#IgnorePkg' /etc/pacman.conf; then
    sed -i '/^#IgnorePkg/c\IgnorePkg = linux-davinci linux-davinci-headers' /etc/pacman.conf
else
    sed -i '/^\[options\]/a\IgnorePkg = linux-davinci linux-davinci-headers' /etc/pacman.conf
fi
