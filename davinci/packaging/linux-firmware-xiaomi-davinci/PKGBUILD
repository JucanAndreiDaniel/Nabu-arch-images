# Maintainer: arch-xiaomi-davinci
# Nonfree firmware for Xiaomi Mi 9T / Redmi K20 (davinci).
# Upstream: https://github.com/sm7150-mainline/firmware-xiaomi-davinci
# pmOS reference package: firmware-xiaomi-davinci 5-r0 (57.6MiB, /lib/firmware).
#
# Blobs are proprietary and cannot be fetched blindly by CI without accepting
# the redistribution terms. Manual step: clone the upstream repo at a pinned
# commit, review, then build this package. Expected install paths:
#   /lib/firmware/qcom/sm7150/xiaomi/davinci/{adsp,cdsp,modem,venus}.mbn
#   /lib/firmware/qcom/sm7150/xiaomi/davinci/a615_zap.mbn
# NOTE: ipa_fws.mbn is intentionally excluded (see package() below).
# plus ath10k calibration variant "xiaomi_davinci" (see
# firmware-qcom-sm7150-ath10k + linux-firmware-qca/ath10k).

pkgname=linux-firmware-xiaomi-davinci
pkgver=5
pkgrel=2
arch=('aarch64')
license=('custom:proprietary')
url="https://github.com/sm7150-mainline/firmware-xiaomi-davinci"
_commit="7c25d3fe5883f25f8f068e89c6442b4c608835f0"  # main @ 2026-05-17; re-pin after review
source=("firmware-xiaomi-davinci-${_commit}.tar.gz::https://github.com/sm7150-mainline/firmware-xiaomi-davinci/archive/${_commit}.tar.gz")
sha256sums=('SKIP')  # TODO: pin tarball sha256 after first verified build
options=('!strip')

package() {
  cd "firmware-xiaomi-davinci-${_commit}"
  # Upstream tree is rooted at usr/; mirror it into $pkgdir.
  if [ -d usr ]; then
    cp -a usr/. "$pkgdir/usr/"
  else
    echo "ERROR: expected usr/ in firmware tree" >&2
    exit 1
  fi
  # Exclude IPA firmware: the modem/IPA stack must not ship ipa_fws.mbn.
  rm -f "$pkgdir/usr/lib/firmware/qcom/sm7150/xiaomi/davinci/ipa_fws.mbn"
}
