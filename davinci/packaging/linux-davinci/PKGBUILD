# Maintainer: arch-xiaomi-davinci
# Arch kernel for Xiaomi Mi 9T / Redmi K20 (davinci, Samsung panel).
# Upstream: https://github.com/sm7150-mainline/linux (branch v7.2)
# DTB: arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci-samsung.dts
#
# This PKGBUILD builds the fork kernel with the Samsung DTB and installs
# modules + DTBs + Image.
# IMPORTANT: pkgver MUST equal `make kernelversion` of the pinned _commit
# (branch names like v7.2 do not match the tree version; v7.2 tip builds
# 7.1.0). The overlay/UKI tooling addresses /boot/vmlinuz-${pkgver} and
# /boot/dtb-${pkgver}. Bump pkgver/pkgrel on EVERY build so the UKI hook
# fires (same rule as nabu).

pkgname=('linux-davinci' 'linux-davinci-headers')
pkgver=7.1.0
pkgrel=1
arch=('aarch64')
license=('GPL-2.0-only')
url="https://github.com/sm7150-mainline/linux"
_commit="fd78d17954a86ea6ceb0c535e618ea129e09f8dd"  # v7.2 tip at time of writing; pin per build
source=("linux-sm7150-${_commit}.tar.gz::https://github.com/sm7150-mainline/linux/archive/${_commit}.tar.gz")
sha256sums=('SKIP')  # pin after first verified build
makedepends=('bc' 'cpio' 'gettext' 'libelf' 'pahole' 'perl' 'python' 'tar' 'xz' 'gcc' 'make' 'rsync')
options=('!strip')

prepare() {
  cd "linux-${_commit}"
  # Base config exactly like the pocketblue kernel package: upstream
  # defconfig merged with the in-tree sm7150.config + efi.config
  # fragments (-m = merge only, no make step; olddefconfig follows).
  ./scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig \
    arch/arm64/configs/sm7150.config arch/arm64/configs/efi.config
  # Davinci extras/corrections on top (scripts/config fails on unknown
  # symbols, so this also validates davinci.config).
  while IFS= read -r line; do
    case "$line" in
      CONFIG_*=y) ./scripts/config --enable "${line%%=*}" ;;
      CONFIG_*=m) ./scripts/config --module "${line%%=*}" ;;
      CONFIG_*=n) ./scripts/config --disable "${line%%=*}" ;;
    esac
  done < "$startdir/davinci.config"
  make olddefconfig
  # Verify the davinci-relevant effective config. Merge order is defconfig +
  # sm7150.config + efi.config (merge_config.sh -m) with davinci.config
  # applied last via scripts/config, so entries here must win.
  # Ground truth is the WORKING pmOS 7.1.0-sm7150 /boot/config
  # (linux-postmarketos-qcom-sm7150 7.1_rc3): native MSM/KMS display, no
  # simplefb/EFI-fb/logo; panel/touch/backlight builtin; CONFIGFS core =m.
  # Fail the build on mismatch instead of shipping a blind image; the full
  # table also lands in the CI log for post-mortems.
  echo "--- davinci effective-config check ---"
  _need_y() {
    grep -q "^$1=y$" .config || { echo "ERROR: expected $1=y:"; grep "^$1[ =]\|# $1 " .config || echo "  (symbol missing)"; exit 1; }
    echo "ok: $(grep "^$1=" .config)"
  }
  _need_m() {
    grep -q "^$1=m$" .config || { echo "ERROR: expected $1=m:"; grep "^$1[ =]\|# $1 " .config || echo "  (symbol missing)"; exit 1; }
    echo "ok: $(grep "^$1=" .config)"
  }
  _need_off() {
    if grep -q "^$1=y$" .config || grep -q "^$1=m$" .config; then
      echo "ERROR: expected $1 off:"; grep "^$1=" .config; exit 1
    fi
    echo "ok: $1 off"
  }
  for s in DRM DRM_MSM DRM_BRIDGE DRM_MIPI_DSI DRM_PANEL_BRIDGE \
      DRM_PANEL_SAMSUNG_AMS639RQ08 DRM_PANEL_VISIONOX_G1639FP106 \
      TOUCHSCREEN_GOODIX_GTX8 BACKLIGHT_QCOM_WLED \
      FRAMEBUFFER_CONSOLE SERIAL_MSM_CONSOLE SERIAL_EARLYCON \
      USB_GADGET USB_LIBCOMPOSITE USB_F_ACM USB_F_SERIAL U_SERIAL_CONSOLE \
      USB_CONFIGFS_SERIAL USB_CONFIGFS_ACM USB_CONFIGFS_ECM USB_CONFIGFS_RNDIS \
      CONFIGFS_FS \
      PSTORE PSTORE_CONSOLE PSTORE_RAM MAGIC_SYSRQ \
      SCSI_UFS_QCOM SM_GCC_7150 SM_DISPCC_7150; do
    _need_y "CONFIG_${s}"
  done
  for s in BACKLIGHT_PWM USB_CONFIGFS; do
    _need_m "CONFIG_${s}"
  done
  for s in FB_SIMPLE FB_EFI SYSFB_SIMPLEFB DRM_SIMPLEDRM LOGO \
      TOUCHSCREEN_GOODIX; do
    _need_off "CONFIG_${s}"
  done
}

build() {
  cd "linux-${_commit}"
  make -j"$(nproc)" Image.gz modules
  make -j"$(nproc)" DTC_FLAGS="-@" qcom/sm7150-xiaomi-davinci-samsung.dtb
}

package_linux-davinci() {
  pkgdesc="Mainline kernel fork for Xiaomi davinci (Samsung panel)"
  depends=('coreutils' 'kmod' 'mkinitcpio')
  provides=("linux=${pkgver}")
  cd "linux-${_commit}"
  make INSTALL_MOD_PATH="$pkgdir/usr" modules_install
  # Install paths must use the real kernel release (VERSION + EXTRAVERSION
  # + CONFIG_LOCALVERSION, e.g. 7.1.0-sm7150 from sm7150.config), not
  # $pkgver — overlay-post-apply/uki-regenerate address /boot/vmlinuz
  # and /boot/dtb by the modules-dir name.
  _kver=$(cat include/config/kernel.release)
  # Versioned names match what overlay-post-apply / uki-regenerate address
  # (/boot/vmlinuz-${kernver}, /boot/dtb-${kernver}); unversioned names are
  # convenience symlinks.
  install -Dm644 arch/arm64/boot/Image.gz "$pkgdir/boot/vmlinuz-${_kver}"
  ln -s "vmlinuz-${_kver}" "$pkgdir/boot/vmlinuz-linux-davinci"
  install -Dm644 arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci-samsung.dtb \
    "$pkgdir/boot/dtbs/qcom/sm7150-xiaomi-davinci-samsung.dtb"
  install -Dm644 arch/arm64/boot/dts/qcom/sm7150-xiaomi-davinci-samsung.dtb \
    "$pkgdir/boot/dtb-${_kver}"
}

package_linux-davinci-headers() {
  pkgdesc="Headers for linux-davinci"
  depends=('linux-davinci')
  provides=('linux-api-headers')
  conflicts=('linux-api-headers')
  replaces=('linux-api-headers')
  cd "linux-${_commit}"
  make INSTALL_HDR_PATH="$pkgdir/usr" headers_install
}
