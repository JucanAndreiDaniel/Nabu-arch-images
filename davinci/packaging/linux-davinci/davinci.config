# davinci kconfig fragment: Arch/davinci extras applied AFTER defconfig +
# the in-tree arch/arm64/configs/sm7150.config + efi.config (see prepare()).
# Later values win, so entries here override the in-tree fragments.
#
# Also absorbs the parent symbols from pocketblue's davinci-fixups.config:
# without them `make olddefconfig` silently drops e.g. the entire UFS
# storage stack and the USB HS PHY.
#
# Every symbol here was verified to exist in a 7.x sm7150 tree config.

# --- storage parents (pocketblue fixups) ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y

# --- USB parents (pocketblue fixups) ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ULPI_BUS=y

# --- corrections vs in-tree fragments ---
# Ground truth: the WORKING pmOS 7.1.0-sm7150 /boot/config
# (linux-postmarketos-qcom-sm7150 7.1_rc3, same tree family). The 7.1 display
# model is native MSM/KMS from the start: NO simplefb, NO EFI fb, NO logo.
# (An earlier revision followed the stale 6.13 pmOS config here; wrong tree.)
CONFIG_FB_SIMPLE=n
CONFIG_FB_EFI=n
# The DTS simple-framebuffer node is then inert; a sysfb device for it must
# not exist either.
CONFIG_SYSFB_SIMPLEFB=n
# No simpledrm either (working config leaves it unset).
CONFIG_DRM_SIMPLEDRM=n

# Early display: native MSM/KMS + fbdev emulation + fbcon (working 7.1.0
# model). No logo (working config leaves LOGO unset).
CONFIG_DRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=n
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Mainline MSM display stack (davinci Samsung panel).
# Working 7.1.0 model: panel + touch + backlight BUILTIN (the bootloader
# leaves cont-splash scanout running; MSM/KMS takes it over directly, no
# simplefb/EFI-fb/logo involved). Visionox driver stays enabled like pmOS
# (DT compatible selects the panel; no visionox DTB/UKI/U-Boot in v1).
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_MDP4=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_28NM_PHY=y
CONFIG_DRM_MSM_DSI_20NM_PHY=y
CONFIG_DRM_MSM_DSI_28NM_8960_PHY=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_KMS_FBDEV=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL_SAMSUNG_AMS639RQ08=y
CONFIG_DRM_PANEL_VISIONOX_G1639FP106=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=m
CONFIG_BACKLIGHT_QCOM_WLED=y
CONFIG_PWM=y

# Storage: UFS on the phone must be builtin, autodetect builds the
# initramfs on the wrong (CI) hardware.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# Platform: clocks, interconnect, regulators, pinctrl, firmware buses.
CONFIG_SM_GCC_7150=y
CONFIG_SM_DISPCC_7150=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM7150=y
CONFIG_PINCTRL_SM7150=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMPD=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_IOMMU=y
CONFIG_DMA_CMA=y

# Serial consoles (cmdline uses ttyMSM0) + I2C for touch.
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y

# EFI boot.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Touchscreen (builtin, like pmOS 7.1.0).
# pmOS fact: davinci's gt9886 is driven by TOUCHSCREEN_GOODIX_GTX8, not
# TOUCHSCREEN_GOODIX (working config: GTX8=y, GOODIX unset).
CONFIG_TOUCHSCREEN_GOODIX=n
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y

# USB gadget serial (headless debug observability, pmOS 7.1.0 model).
# Working config: GADGET/LIBCOMPOSITE/F_ACM/F_SERIAL/F_OBEX/U_SERIAL/
# CONFIGFS_FS builtin, CONFIGFS core =m (sm7150.config default) with the
# SERIAL/ACM/OBEX/NCM/ECM/RNDIS/EEM/MASS_STORAGE/F_FS/F_HID shims =y.
# USB_G_SERIAL=y is the =y selector that keeps the stack builtin while the
# CONFIGFS core stays =m (a lone =m selector would cap LIBCOMPOSITE to =m);
# as a bonus it auto-binds a serial gadget at boot, so ttyGS0 logging works
# even before the initramfs configfs hook runs.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_OBEX=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_ROLE_SWITCH=y

# Crash observability: DTS reserves ramoops@9d800000 (console/pmsg record)
# and sm7150.config already selects PSTORE_RAM; restated so olddefconfig can
# never drop the last-dmesg path. MAGIC_SYSRQ matches pmOS (serial SysRq).
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_MAGIC_SYSRQ=y
