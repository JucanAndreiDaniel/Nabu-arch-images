# davinci kconfig fragment: Arch/davinci extras applied AFTER defconfig +
# the in-tree arch/arm64/configs/sm7150.config + efi.config (see prepare()).
# Later values win, so entries here override the in-tree fragments.
#
# Also absorbs the parent symbols from pocketblue's davinci-fixups.config:
# without them `make olddefconfig` silently drops e.g. the entire UFS
# storage stack and the USB HS PHY.
#
# Every symbol here was verified to exist in a 7.x sm7150 tree config.

# --- storage parents (pocketblue fixups) ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y

# --- USB parents (pocketblue fixups) ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ULPI_BUS=y

# --- corrections vs in-tree fragments ---
# Cross-checked against the WORKING pmOS build
# (device/community/linux-postmarketos-qcom-sm7150/config-postmarketos-qcom-sm7150.aarch64):
# pmOS ships FB_SIMPLE=y AND FB_EFI=y together on sm7150. efi.config forces
# FB_EFI=n ("Causes issues with u-boot"), but pmOS proves y is correct for
# the sm7150 U-Boot GOP handoff, so re-enable it here (later wins).
CONFIG_FB_SIMPLE=y
CONFIG_FB_EFI=y
# pmOS has "# CONFIG_SYSFB_SIMPLEFB is not set": the DTS simple-framebuffer
# node is owned by FB_SIMPLE; a second sysfb device would compete for it.
CONFIG_SYSFB_SIMPLEFB=n
# Simplefb owns the U-Boot GOP handoff; simpledrm would fight it for the
# same framebuffer node (pmOS also leaves DRM_SIMPLEDRM unset).
CONFIG_DRM_SIMPLEDRM=n

# Early display: simplefb owns the U-Boot GOP handoff (FB_SIMPLE comes
# from sm7150.config); fbcon + logo on top.
CONFIG_DRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Mainline MSM display stack (davinci Samsung panel).
# pmOS ships the panel + backlight as MODULES loaded from the initramfs
# (see device-xiaomi-davinci/modules-initfs: gtx8, panel_samsung_ams639rq08):
# builtin panel/MSM would tear down the simplefb GOP handoff before the
# initramfs is up. Match that model: panel/backlight =m, loaded via
# mkinitcpio MODULES (overlay-post-apply).
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_MDP4=y
CONFIG_DRM_MSM_MDP5=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_28NM_PHY=y
CONFIG_DRM_MSM_DSI_20NM_PHY=y
CONFIG_DRM_MSM_DSI_28NM_8960_PHY=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_KMS_FBDEV=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_BRIDGE=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_DRM_PANEL_SAMSUNG_AMS639RQ08=m
# Visionox panel explicitly unsupported in v1 (sm7150.config enables it;
# a builtin second panel driver must not claim the DSI link).
CONFIG_DRM_PANEL_VISIONOX_G1639FP106=n
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=m
CONFIG_BACKLIGHT_QCOM_WLED=m
CONFIG_PWM=y

# Storage: UFS on the phone must be builtin, autodetect builds the
# initramfs on the wrong (CI) hardware.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# Platform: clocks, interconnect, regulators, pinctrl, firmware buses.
CONFIG_SM_GCC_7150=y
CONFIG_SM_DISPCC_7150=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_GDSC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_SM7150=y
CONFIG_PINCTRL_SM7150=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMPD=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_IOMMU=y
CONFIG_DMA_CMA=y

# Serial consoles (cmdline uses ttyMSM0) + I2C for touch.
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y

# EFI boot.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Touchscreen (module, pinned into the initramfs via mkinitcpio MODULES).
# pmOS fact: davinci's gt9886 is driven by TOUCHSCREEN_GOODIX_GTX8, not
# TOUCHSCREEN_GOODIX (sm7150.config forces GOODIX=n; pmOS final =m for GTX8
# and unset for GOODIX; device-xiaomi-davinci/modules-initfs lists gtx8).
CONFIG_TOUCHSCREEN_GOODIX=n
CONFIG_TOUCHSCREEN_GOODIX_GTX8=m

# USB gadget serial (headless debug observability, pmOS model: all builtin).
# sm7150.config only has USB_CONFIGFS=m; pmOS final builds the gadget stack
# builtin (LIBCOMPOSITE/F_ACM/F_SERIAL/CONFIGFS=y + U_SERIAL_CONSOLE=y) so a
# configfs serial console can be raised from the initramfs/userspace even
# when the display is dead. Legacy G_SERIAL stays off, like pmOS.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_CONFIGFS_FS=y

# Crash observability: DTS reserves ramoops@9d800000 (console/pmsg record)
# and sm7150.config already selects PSTORE_RAM; restated so olddefconfig can
# never drop the last-dmesg path. MAGIC_SYSRQ matches pmOS (serial SysRq).
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_MAGIC_SYSRQ=y
